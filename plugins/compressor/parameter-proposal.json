  "normalization": {
    "linear": "n=(clamp(p,min,max)-min)/(max-min); inverse p=min+n*(max-min)",
    "logarithmic": "n=log(clamp(p,min,max)/min)/log(max/min); inverse p=min*(max/min)^n",
    "discrete": "physical ordinal=round(clamp(n,0,1)*stepCount); explicit enum label order approved by Dot",
    "nonfinite": "Use declared physical Init then normalize; invalid physical values are bounded before DSP",
    "cutoff": "Absolute Hz normalization stays independent of sample rate; only effective DSP cutoff is clamped to 0.45Fs",
    "percent": "Host units 0..100 percent; Core Settings fractions 0..1"
  },
